		displayFolder: 5. Cartões
		lineageTag: 449e2bd4-15fd-4f39-b17e-d3754954c440

	/// Verde = melhorou, vermelho = piorou, cinza = estável. Para este indicador, subir é bom.
	measure 'Cor var. resolvidas' =
			VAR v = [Var. resolvidas (p.p.)]
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( v ) || ABS ( v ) < 0.1, "#7D7E92",
					v * 1 > 0, "#067A3A",
					"#C62F3A"
				)
		displayFolder: 5. Cartões
		lineageTag: 2f7e3671-9613-4dd2-a96f-0f1c3a14121a

	/// Seta e variação contra o ano anterior, para usar embaixo do cartão.
	measure 'Texto var. nota' =
			VAR v = [Var. nota]
			RETURN
				IF (
					ISBLANK ( v ),
					IF ( HASONEVALUE ( dim_calendario[ano] ), "sem ano anterior", "selecione um ano" ),
					IF ( v > 0, "▲ ", IF ( v < 0, "▼ ", "■ " ) ) & FORMAT ( v, "+0.00;-0.00;0.00" )
						& " vs " & ( MAX ( dim_calendario[ano] ) - 1 )
				)
		displayFolder: 5. Cartões
		lineageTag: b1f21e7a-f9a2-445c-848c-38ec203e4054

	/// Verde = melhorou, vermelho = piorou, cinza = estável. Para este indicador, subir é bom.
	measure 'Cor var. nota' =
			VAR v = [Var. nota]
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( v ) || ABS ( v ) < 0.01, "#7D7E92",
					v * 1 > 0, "#067A3A",
					"#C62F3A"
				)
		displayFolder: 5. Cartões
		lineageTag: 144a5d63-1808-448a-9073-73760e074794


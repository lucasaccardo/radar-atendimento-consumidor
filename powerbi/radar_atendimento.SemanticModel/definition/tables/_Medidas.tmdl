table _Medidas
	lineageTag: c4f1b41a-edc8-4448-923d-8072da33b31b

	/// Registros de reclamação no período. Cada reabertura conta como um registro.
	measure Reclamações = SUM ( fato_atendimento_mensal[reclamacoes] )
		formatString: #,0
		displayFolder: 1. Indicadores
		lineageTag: 24df5d0c-a6e5-47a9-b31a-13eff5452e27

	/// Reclamações com UF informada dividido pela população do IBGE do ano selecionado.
	measure 'Reclamações por 100 mil hab.' =
			VAR RecComUF = CALCULATE ( [Reclamações], KEEPFILTERS ( dim_uf[uf] <> "NI" ) )
			RETURN DIVIDE ( RecComUF, [População] ) * 100000
		formatString: #,0.0
		displayFolder: 1. Indicadores
		lineageTag: b2541f64-e99b-4c41-bbe4-1bdadc103bd3

	/// Média ponderada: soma dos tempos dividido pela quantidade de tempos válidos.
	measure 'Tempo de resposta (dias)' =
			DIVIDE (
				SUM ( fato_atendimento_mensal[soma_tempo_resposta] ),
				SUM ( fato_atendimento_mensal[qtd_tempo_resposta] )
			)
		formatString: 0.0
		displayFolder: 1. Indicadores
		lineageTag: 58ceb0cf-0c79-46e6-8757-520f8ef49217

	/// Respondidas em até 10 dias dividido pelo total de reclamações.
	measure '% Respondidas no prazo' = DIVIDE ( SUM ( fato_atendimento_mensal[respondidas_no_sla] ), [Reclamações] )
		formatString: 0.0%
		displayFolder: 1. Indicadores
		lineageTag: baabcda5-39e4-4d34-9cf3-2a23e8dcfb60

	/// Registros que são reaberturas dividido pelo total de registros.
	measure 'Taxa de reabertura' = DIVIDE ( SUM ( fato_atendimento_mensal[reabertas] ), [Reclamações] )
		formatString: 0.0%
		displayFolder: 1. Indicadores
		lineageTag: 13a116b7-d2ed-41be-a05a-2f533fbe0cd7

	/// Resolvidas dividido pelas reclamações que o consumidor avaliou.
	measure '% Resolvidas' = DIVIDE ( SUM ( fato_atendimento_mensal[resolvidas] ), SUM ( fato_atendimento_mensal[avaliadas] ) )
		formatString: 0.0%
		displayFolder: 1. Indicadores
		lineageTag: 13f2e338-9256-4de1-8f43-75ef619265e1

	/// Média ponderada das notas válidas (1 a 5).
	measure 'Nota média' = DIVIDE ( SUM ( fato_atendimento_mensal[soma_nota] ), SUM ( fato_atendimento_mensal[qtd_nota] ) )
		formatString: 0.00
		displayFolder: 1. Indicadores
		lineageTag: 780f5df8-a726-4fb7-beae-7455f2980ad8

	/// Soma da população das UFs filtradas no ano selecionado (sem a UF NI).
	measure População =
			VAR AnoRef = MAX ( dim_calendario[ano] )
			RETURN
				SUMX (
					FILTER ( VALUES ( dim_uf[uf] ), dim_uf[uf] <> "NI" ),
					LOOKUPVALUE (
						dim_populacao[populacao],
						dim_populacao[uf], dim_uf[uf],
						dim_populacao[ano], AnoRef
					)
				)
		formatString: #,0
		displayFolder: 2. Apoio
		lineageTag: 70273ecd-cfcc-4031-be2c-e7ee77695a1b

	/// Participação da linha no total da seleção atual.
	measure 'Participação %' = DIVIDE ( [Reclamações], CALCULATE ( [Reclamações], ALLSELECTED () ) )
		formatString: 0.0%
		displayFolder: 2. Apoio
		lineageTag: 29e158e9-5f3d-4f82-8c25-8d1eabda259e

	/// Reclamações do período dividido pela quantidade de meses com dados.
	measure 'Média mensal' = DIVIDE ( [Reclamações], CALCULATE ( COUNTROWS ( dim_calendario ), dim_calendario[tem_dados] = TRUE () ) )
		formatString: #,0
		displayFolder: 2. Apoio
		lineageTag: 81888109-510b-4675-9001-ee2c84b6d981

	/// Média das reclamações dos 3 últimos meses até o mês do contexto.
	measure 'Média móvel 3 meses' =
			VAR MesAtual = MAX ( dim_calendario[data_mes] )
			VAR Janela =
				FILTER (
					ALL ( dim_calendario ),
					dim_calendario[data_mes] > EDATE ( MesAtual, -3 )
						&& dim_calendario[data_mes] <= MesAtual
						&& dim_calendario[tem_dados]
				)
			RETURN
				IF ( COUNTROWS ( Janela ) = 3, DIVIDE ( SUMX ( Janela, [Reclamações] ), 3 ) )
		formatString: #,0
		displayFolder: 2. Apoio
		lineageTag: 0806574a-4e4f-42fb-bbfa-7ab51e4e4efb

	/// Reclamações de janeiro até o mês do contexto, no mesmo ano.
	measure 'Acumulado no ano' =
			VAR MesAtual = MAX ( dim_calendario[data_mes] )
			RETURN
				CALCULATE (
					[Reclamações],
					REMOVEFILTERS ( dim_calendario ),
					dim_calendario[ano] = YEAR ( MesAtual ),
					dim_calendario[data_mes] <= MesAtual
				)
		formatString: #,0
		displayFolder: 2. Apoio
		lineageTag: 8edd1b0c-242a-41d5-8fd4-ff779bf5ccdc

	/// Texto do período comparado, por exemplo jan–set/2026 vs jan–set/2025.
	measure 'Período analisado' =
			VAR AnoSel = SELECTEDVALUE ( dim_calendario[ano] )
			VAR MesIni = CALCULATE ( MIN ( dim_calendario[mes] ), dim_calendario[tem_dados] = TRUE () )
			VAR MesFim = CALCULATE ( MAX ( dim_calendario[mes] ), dim_calendario[tem_dados] = TRUE () )
			VAR NomeIni = LOOKUPVALUE ( dim_calendario[nome_mes], dim_calendario[mes], MesIni )
			VAR NomeFim = LOOKUPVALUE ( dim_calendario[nome_mes], dim_calendario[mes], MesFim )
			VAR Faixa = IF ( MesIni = MesFim, NomeIni, NomeIni & "–" & NomeFim )
			VAR TemAnterior = NOT ISBLANK ( [Reclamações (ano anterior)] )
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( AnoSel ), "Selecione um ano",
					ISBLANK ( MesIni ), BLANK (),
					TemAnterior, Faixa & "/" & ( AnoSel - 1 ) & " → " & Faixa & "/" & AnoSel,
					Faixa & "/" & AnoSel & " (sem ano anterior para comparar)"
				)
		displayFolder: 2. Apoio
		lineageTag: 63e381ae-3729-42ea-8e96-c8fa70d63b9b

	/// Reclamações da base de registros por canal de entrada. A operadora é ligada por relacionamento virtual (TREATAS), porque essa base vem agrupada por grupo de operadora.
	measure 'Solicitações por canal' =
			CALCULATE (
				SUM ( fato_canal_mensal[solicitacoes] ),
				TREATAS ( VALUES ( dim_operadora[operadora_exibicao] ), fato_canal_mensal[operadora] )
			)
		formatString: #,0
		displayFolder: 2. Apoio
		lineageTag: cc2078fe-72e1-4a8c-a3cb-1a623595cb12

	/// Participação de cada canal no total de solicitações da seleção.
	measure '% do canal' = DIVIDE ( [Solicitações por canal], CALCULATE ( [Solicitações por canal], REMOVEFILTERS ( fato_canal_mensal[canal_entrada] ) ) )
		formatString: 0.0%
		displayFolder: 2. Apoio
		lineageTag: e28624fa-3180-4356-abe1-8af4cec58bd0

	/// Mesmos meses do ano anterior aos meses com dados do ano selecionado. Fica em branco se houver mais de um ano selecionado.
	measure 'Reclamações (ano anterior)' =
			VAR AnoSel = SELECTEDVALUE ( dim_calendario[ano] )
			VAR MesesComDados =
				CALCULATETABLE ( VALUES ( dim_calendario[mes] ), dim_calendario[tem_dados] = TRUE () )
			RETURN
				IF (
					NOT ISBLANK ( AnoSel ),
					CALCULATE (
						[Reclamações],
						REMOVEFILTERS ( dim_calendario ),
						dim_calendario[ano] = AnoSel - 1,
						TREATAS ( MesesComDados, dim_calendario[mes] )
					)
				)
		formatString: #,0
		displayFolder: 3. Ano anterior (mesmo período)
		lineageTag: 6718bc89-96c9-4093-a79a-dda9d2c8e903


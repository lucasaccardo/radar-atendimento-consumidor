{
  "name": "Radar de Atendimento",
  "dataColors": [
    "#2A01CD",
    "#AEB0C2",
    "#09BFAF",
    "#F05252",
    "#0F0F72",
    "#A6B7FF",
    "#7D7E92",
    "#B8860B"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F0F0F",
  "tableAccent": "#2A01CD",
  "good": "#067A3A",
  "neutral": "#7D7E92",
  "bad": "#C62F3A",
  "maximum": "#2A01CD",
  "center": "#A6B7FF",
  "minimum": "#EEF0FF",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F0F72"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F0F72"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F0F0F"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#46465A"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F2F3F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E4EE"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F0F72"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6E7EF"
              }
            },
            "gridVertical": false
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6E7EF"
              }
            },
            "gridVertical": false
          }
        ]
      }
    }
  }
}